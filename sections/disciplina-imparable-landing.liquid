      <span class="di sticky-bar__price">Solo ${{ section.settings.price_now }} USD</span>
    </div>
    <a href="{{ section.settings.product_url }}" class="di btn btn--primary">
      {{ section.settings.sticky_cta }}
    </a>
  </div>

</div>

<script>
(function () {
  var selAll = function (s) { return document.querySelectorAll('#disciplina-imparable ' + s); };

  // Shopify Customizer: mostrar todo inmediatamente
  if (window.Shopify && window.Shopify.designMode) {
    selAll('.reveal').forEach(function (el) { el.classList.add('visible'); });
  }

  // Scroll reveal (solo fuera del Customizer)
  var io = new IntersectionObserver(function (entries) {
    entries.forEach(function (e) { if (e.isIntersecting) e.target.classList.add('visible'); });
  }, { threshold: 0.08 });
  if (!(window.Shopify && window.Shopify.designMode)) {
    selAll('.reveal').forEach(function (el) { io.observe(el); });
  }

  // FAQ accordion
  document.querySelectorAll('#disciplina-imparable .faq__trigger').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var item = btn.closest('.faq__item');
      var open = item.classList.contains('open');
      document.querySelectorAll('#disciplina-imparable .faq__item').forEach(function (i) { i.classList.remove('open'); });
      if (!open) item.classList.add('open');
    });
  });

  // Sticky bar
  var hero   = document.querySelector('#disciplina-imparable .hero');
  var sticky = document.getElementById('di-sticky');
  if (hero && sticky) {
    new IntersectionObserver(function (e) {
      sticky.style.display = e[0].isIntersecting ? 'none' : 'flex';
    }, { threshold: 0 }).observe(hero);
  }
})();
</script>

{% schema %}
{
  "name": "Disciplina Imparable",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Hero" },
    { "type": "text", "id": "hero_eyebrow", "label": "Eyebrow", "default": "Ebook Premium · Desarrollo Personal" },
    { "type": "text", "id": "hero_word_sans", "label": "Palabra sans-serif (Inter 800)", "default": "Disciplina" },
    { "type": "text", "id": "hero_word_serif", "label": "Palabra serif italic (Cormorant)", "default": "Imparable" },
