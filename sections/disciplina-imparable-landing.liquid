    </div>
  </section>

  {%- comment -%} ── CTA INTERMEDIO ── {%- endcomment -%}
  <div class="di mid-cta">
    <div class="di wrap">
      <p class="di mid-cta__text reveal">{{ section.settings.mid_cta_text }}</p>
      <a href="{{ section.settings.product_url }}" class="di btn btn--primary reveal">
        {{ section.settings.mid_cta_btn }}
      </a>
    </div>
  </div>

  {%- comment -%} ── 05 TESTIMONIOS ── {%- endcomment -%}
  <section class="di section section--s1">
    <div class="di wrap">
      <div class="di section-label reveal">
        <span class="di num">05</span>
        {{ section.settings.testimonials_label }}
      </div>
      <div class="di testimonials__grid">
        {%- assign t_index = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'testimonial' -%}
            {%- assign t_index = t_index | plus: 1 -%}
