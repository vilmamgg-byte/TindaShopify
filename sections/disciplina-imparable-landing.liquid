{% comment %} Disciplina Imparable — Landing Page v2 {% endcomment %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;0,700;1,300;1,400;1,600;1,700&family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
{{ 'disciplina-imparable.css' | asset_url | stylesheet_tag }}

<div class="di-root" id="di-page">

  {%- comment -%} ══ HERO ══ {%- endcomment -%}
  <section class="di-hero" aria-label="Inicio">
    <div class="di-hero-inner">

      <span class="di-eyebrow">{{ section.settings.hero_eyebrow }}</span>

      <h1 class="di-display">
        <span class="di-word-sans">{{ section.settings.hero_word_sans }}</span>
        <span class="di-word-serif">{{ section.settings.hero_word_serif }}</span>
      </h1>

      <div class="di-hero-rule" aria-hidden="true"></div>

      <p class="di-subtitle">{{ section.settings.hero_subtitle }}</p>

      <div class="di-hero-cta">
        <a href="{{ section.settings.product_url }}" class="di-btn di-btn-primary">
          {{ section.settings.hero_cta }}
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
        <span class="di-proof">
          <strong>{{ section.settings.proof_number }}</strong> {{ section.settings.proof_text }}
        </span>
      </div>

    </div>
    <div class="di-scroll-indicator" aria-hidden="true">
      <span>Scroll</span>
      <div class="di-scroll-track"></div>
    </div>
  </section>

  {%- comment -%} ══ MÉTRICAS ══ {%- endcomment -%}
  <div class="di-metrics" role="region" aria-label="Estadísticas">
    <div class="di-metrics-inner di-wrap">
      <div class="di-metric di-reveal">
        <span class="di-metric-num"
              data-counter="{{ section.settings.stat_1_raw }}"
              data-counter-suffix="{{ section.settings.stat_1_suffix }}">
          {{- section.settings.stat_1_num -}}
        </span>
        <span class="di-metric-label">{{ section.settings.stat_1_label }}</span>
      </div>
      <div class="di-metric di-reveal di-d2">
        <span class="di-metric-num"
              data-counter="{{ section.settings.stat_2_raw }}"
              data-counter-suffix="{{ section.settings.stat_2_suffix }}">
          {{- section.settings.stat_2_num -}}
        </span>
        <span class="di-metric-label">{{ section.settings.stat_2_label }}</span>
      </div>
      <div class="di-metric di-reveal di-d3">
        <span class="di-metric-num"
              data-counter="{{ section.settings.stat_3_raw }}"
              data-counter-suffix="{{ section.settings.stat_3_suffix }}">
          {{- section.settings.stat_3_num -}}
        </span>
        <span class="di-metric-label">{{ section.settings.stat_3_label }}</span>
      </div>
    </div>
  </div>

  {%- comment -%} ══ 01 DOLOR ══ {%- endcomment -%}
  <section class="di-section di-bg2" aria-label="El problema">
    <div class="di-wrap">
      <div class="di-pain-grid">
        <div>
          <div class="di-label di-reveal">
            <span class="di-num">01</span>{{ section.settings.pain_label }}
          </div>
          <h2 class="di-pain-headline di-reveal">{{ section.settings.pain_headline }}</h2>
        </div>
        <div>
          <ul class="di-pain-list" role="list">
            {%- for block in section.blocks -%}
              {%- if block.type == 'pain_point' -%}
                <li class="di-pain-item di-reveal di-d{{ forloop.index }}"
                    role="listitem"
                    {{ block.shopify_attributes }}>{{ block.settings.text }}</li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
          <div class="di-pain-bridge di-reveal">
            <div class="di-bridge-rule" aria-hidden="true"></div>
            <p class="di-bridge-text">{{ section.settings.pain_bridge }}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  {%- comment -%} ══ 02 SOLUCIÓN ══ {%- endcomment -%}
  <section class="di-section di-bg0" aria-label="La solución">
    <div class="di-wrap">
      <div class="di-label di-reveal" style="justify-content:center">
        <span class="di-num">02</span>{{ section.settings.solution_label }}
      </div>
      <div class="di-promise-center">
        <div class="di-promise-title di-reveal">
          <span class="di-title-sans">{{ section.settings.hero_word_sans }}</span>
          <span class="di-title-serif">{{ section.settings.hero_word_serif }}</span>
        </div>
        <p class="di-promise-body di-reveal">{{ section.settings.solution_body }}</p>
        <blockquote class="di-promise-quote di-reveal">{{ section.settings.solution_promise }}</blockquote>
      </div>
    </div>
  </section>

  {%- comment -%} ══ 03 BENEFICIOS ══ {%- endcomment -%}
  <section class="di-section di-bg1" aria-label="Beneficios">
    <div class="di-wrap">
      <div class="di-label di-reveal">
        <span class="di-num">03</span>{{ section.settings.benefits_label }}
      </div>
      <div class="di-benefits-grid">
        {%- assign bi = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'benefit' -%}
            {%- assign bi = bi | plus: 1 -%}
            {%- assign delay_b = 'di-d' | append: bi -%}
            <div class="di-benefit di-reveal {{ delay_b }}" {{ block.shopify_attributes }}>
              <span class="di-benefit-num" aria-hidden="true">
                {%- if bi < 10 -%}0{%- endif -%}{{ bi }}
              </span>
              <h3 class="di-benefit-title">{{ block.settings.title }}</h3>
              <p class="di-benefit-text">{{ block.settings.text }}</p>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>

  {%- comment -%} ══ 04 CONTENIDO ══ {%- endcomment -%}
  <section class="di-section di-bg2" aria-label="Contenido del ebook">
    <div class="di-wrap">
      <div class="di-label di-reveal">
        <span class="di-num">04</span>{{ section.settings.contents_label }}
      </div>
      <div class="di-chapters">
        {%- assign ci = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'chapter' -%}
            {%- assign ci = ci | plus: 1 -%}
            {%- assign delay_c = 'di-d' | append: ci -%}
            <div class="di-chapter di-reveal {{ delay_c }}" {{ block.shopify_attributes }}>
              <span class="di-chapter-num" aria-hidden="true">
                {%- if ci < 10 -%}0{%- endif -%}{{ ci }}
              </span>
              <div>
                <p class="di-chapter-title">{{ block.settings.title }}</p>
                {%- if block.settings.desc != blank -%}
                  <p class="di-chapter-desc">{{ block.settings.desc }}</p>
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>

  {%- comment -%} ══ CTA INTERMEDIO ══ {%- endcomment -%}
  <div class="di-mid-cta">
    <div class="di-wrap">
      <p class="di-mid-text di-reveal">{{ section.settings.mid_cta_text }}</p>
      <a href="{{ section.settings.product_url }}"
         class="di-btn di-btn-primary di-reveal di-d2">{{ section.settings.mid_cta_btn }}</a>
    </div>
  </div>

  {%- comment -%} ══ 05 TESTIMONIOS ══ {%- endcomment -%}
  <section class="di-section di-bg1" aria-label="Testimonios">
    <div class="di-wrap">
      <div class="di-label di-reveal">
        <span class="di-num">05</span>{{ section.settings.testimonials_label }}
      </div>
      <div class="di-testimonials-grid">
        {%- assign ti = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'testimonial' -%}
            {%- assign ti = ti | plus: 1 -%}
            {%- assign delay_t = 'di-d' | append: ti -%}
            <div class="di-testimonial di-reveal {{ delay_t }}" {{ block.shopify_attributes }}>
              <p class="di-testimonial-text">{{ block.settings.quote }}</p>
              <div class="di-testimonial-author">
                <div class="di-avatar" aria-hidden="true">{{ block.settings.name | slice: 0 }}</div>
                <div>
                  <p class="di-testimonial-name">{{ block.settings.name }}</p>
                  <p class="di-testimonial-role">{{ block.settings.role }}</p>
                </div>
              </div>
              <div class="di-stars" role="img" aria-label="5 estrellas">
                <span class="di-star"></span><span class="di-star"></span>
                <span class="di-star"></span><span class="di-star"></span>
                <span class="di-star"></span>
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>

  {%- comment -%} ══ 06 PRECIO ══ {%- endcomment -%}
  <section class="di-offer" id="di-comprar" aria-label="Oferta">
    <div class="di-wrap">
      <div class="di-label di-reveal" style="justify-content:center">
        <span class="di-num">06</span>{{ section.settings.offer_label }}
      </div>
      <div class="di-offer-inner">

        <div class="di-offer-product di-reveal">
          <span class="di-offer-name">{{ section.settings.hero_word_sans }} {{ section.settings.hero_word_serif }}</span>
          <span class="di-offer-subtitle">{{ section.settings.offer_subtitle }}</span>
        </div>

        <ul class="di-includes di-reveal di-d2">
          {%- for block in section.blocks -%}
            {%- if block.type == 'include' -%}
              <li {{ block.shopify_attributes }}>{{ block.settings.text }}</li>
            {%- endif -%}
          {%- endfor -%}
        </ul>

        <div class="di-price-block di-reveal di-d3">
          <span class="di-price-was">{{ section.settings.price_was }}</span>
          <span class="di-price-now"><sup>$</sup>{{ section.settings.price_now }}</span>
          <span class="di-price-context">{{ section.settings.price_context }}</span>
        </div>

        <p class="di-urgency di-reveal di-d4">{{ section.settings.urgency_text }}</p>

        <a href="{{ section.settings.product_url }}"
           class="di-btn di-btn-primary di-offer-btn di-reveal di-d5"
           style="width:100%;max-width:360px;display:flex;">
          {{ section.settings.offer_cta }}
        </a>

        <p class="di-offer-guarantee di-reveal di-d6">{{ section.settings.guarantee_short }}</p>

      </div>
    </div>
  </section>

  {%- comment -%} ══ 07 GARANTÍA ══ {%- endcomment -%}
  <section class="di-section di-bg2" aria-label="Garantía">
    <div class="di-wrap">
      <div class="di-label di-reveal" style="justify-content:center">
        <span class="di-num">07</span>Garantía
      </div>
      <div class="di-guarantee di-reveal">
        <p class="di-guarantee-title">{{ section.settings.guarantee_title }}</p>
        <p class="di-guarantee-text">{{ section.settings.guarantee_text }}</p>
      </div>
    </div>
  </section>

  {%- comment -%} ══ 08 FAQ ══ {%- endcomment -%}
  <section class="di-section di-bg1" aria-label="Preguntas frecuentes">
    <div class="di-wrap">
      <div class="di-label di-reveal">
        <span class="di-num">08</span>{{ section.settings.faq_label }}
      </div>
      <div class="di-faq" role="list">
        {%- for block in section.blocks -%}
          {%- if block.type == 'faq' -%}
            <div class="di-faq-item di-reveal" role="listitem" {{ block.shopify_attributes }}>
              <button class="di-faq-trigger"
                      type="button"
                      aria-expanded="false"
                      aria-controls="faq-{{ forloop.index }}">
                <span class="di-faq-q">{{ block.settings.question }}</span>
                <span class="di-faq-icon" aria-hidden="true"></span>
              </button>
              <div class="di-faq-body" id="faq-{{ forloop.index }}">{{ block.settings.answer }}</div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>

  {%- comment -%} ══ CTA FINAL ══ {%- endcomment -%}
  <section class="di-final" aria-label="Llamada a la acción final">
    <div class="di-wrap">
      <div class="di-final-inner">
        <h2 class="di-final-title di-reveal">
          {{ section.settings.final_line1 }}<br>
          <span>{{ section.settings.final_line2 }}</span>
        </h2>
        <p class="di-final-sub di-reveal di-d2">{{ section.settings.final_sub }}</p>
        <a href="{{ section.settings.product_url }}"
           class="di-btn di-btn-primary di-reveal di-d3">{{ section.settings.final_cta }}</a>
        <p class="di-final-note di-reveal di-d4">{{ section.settings.guarantee_short }}</p>
      </div>
    </div>
  </section>

  {%- comment -%} ══ STICKY BAR MOBILE ══ {%- endcomment -%}
  <div class="di-sticky" id="di-sticky" role="complementary" aria-label="Compra rápida">
    <div class="di-sticky-info">
      <span class="di-sticky-name">{{ section.settings.hero_word_sans }} {{ section.settings.hero_word_serif }}</span>
      <span class="di-sticky-price">Solo ${{ section.settings.price_now }} USD</span>
    </div>
    <a href="{{ section.settings.product_url }}" class="di-btn di-btn-primary">{{ section.settings.sticky_cta }}</a>
  </div>

</div>

<script>
(function () {
  'use strict';
  var root = document.getElementById('di-page');
  if (!root) return;

  // ── Scroll reveal ────────────────────────────────────────────
  if ('IntersectionObserver' in window) {
    var revealIO = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (e.isIntersecting) {
          e.target.classList.add('di-visible');
          revealIO.unobserve(e.target);
        }
      });
    }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
    root.querySelectorAll('.di-reveal').forEach(function (el) { revealIO.observe(el); });
  } else {
    root.querySelectorAll('.di-reveal').forEach(function (el) { el.classList.add('di-visible'); });
  }

  // ── Counter animation ────────────────────────────────────────
  var counters = root.querySelectorAll('[data-counter]');
  if ('IntersectionObserver' in window && counters.length) {
    var counterIO = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (!e.isIntersecting) return;
        var el = e.target;
        var target = parseInt(el.dataset.counter, 10);
        if (isNaN(target)) return;
        var suffix = el.dataset.counterSuffix || '';
        var duration = 1600;
        var startTime = null;
        function tick(ts) {
          if (!startTime) startTime = ts;
          var progress = Math.min((ts - startTime) / duration, 1);
          var eased = 1 - Math.pow(1 - progress, 3);
          el.textContent = Math.round(eased * target).toLocaleString() + suffix;
          if (progress < 1) requestAnimationFrame(tick);
        }
        requestAnimationFrame(tick);
        counterIO.unobserve(el);
      });
    }, { threshold: 0.6 });
    counters.forEach(function (el) { counterIO.observe(el); });
  }

  // ── FAQ accordion ────────────────────────────────────────────
  root.querySelectorAll('.di-faq-trigger').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var item = btn.closest('.di-faq-item');
      var isOpen = item.classList.contains('di-open');
      root.querySelectorAll('.di-faq-item.di-open').forEach(function (i) {
        i.classList.remove('di-open');
        i.querySelector('.di-faq-trigger').setAttribute('aria-expanded', 'false');
      });
      if (!isOpen) {
        item.classList.add('di-open');
        btn.setAttribute('aria-expanded', 'true');
      }
    });
  });

  // ── Sticky bar (solo mobile, aparece al salir del hero) ──────
  var hero = root.querySelector('.di-hero');
  var sticky = document.getElementById('di-sticky');
  if (hero && sticky && 'IntersectionObserver' in window) {
    var isMobile = function () { return window.innerWidth <= 640; };
    new IntersectionObserver(function (entries) {
      if (!isMobile()) return;
      sticky.style.display = entries[0].isIntersecting ? 'none' : 'flex';
    }, { threshold: 0 }).observe(hero);
  }

})();
</script>

{% schema %}
{
  "name": "Disciplina Imparable",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "─── Hero ────────────────────────" },
    { "type": "text",     "id": "hero_eyebrow",   "label": "Eyebrow",                          "default": "Ebook Premium · Desarrollo Personal" },
    { "type": "text",     "id": "hero_word_sans",  "label": "Palabra principal (sans-serif)",   "default": "Disciplina" },
    { "type": "text",     "id": "hero_word_serif", "label": "Palabra acento (serif, itálica)",  "default": "Imparable" },
    { "type": "textarea", "id": "hero_subtitle",   "label": "Subtítulo",                        "default": "El método que usan las personas más imparables del mundo para convertir sus metas en resultados reales — sin excusas, sin atajos." },
    { "type": "text",     "id": "hero_cta",        "label": "Botón CTA hero",                   "default": "Obtener el Ebook" },
    { "type": "url",      "id": "product_url",     "label": "URL del producto / checkout" },
    { "type": "text",     "id": "proof_number",    "label": "Número social proof",              "default": "5,000+" },
    { "type": "text",     "id": "proof_text",      "label": "Texto social proof",               "default": "lectores · Garantía 7 días" },

    { "type": "header", "content": "─── Métricas ────────────────────" },
    { "type": "text", "id": "stat_1_num",    "label": "Métrica 1 — texto a mostrar",  "default": "5,000+",    "info": "Este texto se muestra antes de que cargue la animación." },
    { "type": "text", "id": "stat_1_raw",    "label": "Métrica 1 — número (solo cifra, ej: 5000)", "default": "5000" },
    { "type": "text", "id": "stat_1_suffix", "label": "Métrica 1 — sufijo (ej: +, k, %)",           "default": "+" },
    { "type": "text", "id": "stat_1_label",  "label": "Métrica 1 — etiqueta",         "default": "Lectores" },
    { "type": "text", "id": "stat_2_num",    "label": "Métrica 2 — texto a mostrar",  "default": "4.9 / 5" },
    { "type": "text", "id": "stat_2_raw",    "label": "Métrica 2 — número (cifra)",   "default": "" },
    { "type": "text", "id": "stat_2_suffix", "label": "Métrica 2 — sufijo",           "default": "" },
    { "type": "text", "id": "stat_2_label",  "label": "Métrica 2 — etiqueta",         "default": "Valoración promedio" },
    { "type": "text", "id": "stat_3_num",    "label": "Métrica 3 — texto a mostrar",  "default": "30 días" },
    { "type": "text", "id": "stat_3_raw",    "label": "Métrica 3 — número (cifra)",   "default": "30" },
    { "type": "text", "id": "stat_3_suffix", "label": "Métrica 3 — sufijo",           "default": "" },
    { "type": "text", "id": "stat_3_label",  "label": "Métrica 3 — etiqueta",         "default": "Para resultados visibles" },

    { "type": "header", "content": "─── Sección Dolor ───────────────" },
    { "type": "text",     "id": "pain_label",    "label": "Label sección",  "default": "El Problema" },
    { "type": "textarea", "id": "pain_headline", "label": "Headline",       "default": "¿Cuántas veces has comenzado algo y no lo has terminado?" },
    { "type": "textarea", "id": "pain_bridge",   "label": "Texto puente",   "default": "El problema no es tu motivación. Es que nadie te enseñó a construir disciplina." },

    { "type": "header", "content": "─── Sección Solución ────────────" },
    { "type": "text",     "id": "solution_label",   "label": "Label sección", "default": "La Solución" },
    { "type": "textarea", "id": "solution_body",    "label": "Cuerpo",        "default": "No es un libro de motivación efímera. Es un sistema probado para construir la mentalidad y los hábitos de las personas más exitosas del mundo." },
    { "type": "textarea", "id": "solution_promise", "label": "Promesa central (cita destacada)", "default": "En 30 días, tendrás un sistema mental y de acción que cambiará la forma en que te relacionas con tus metas para siempre." },

    { "type": "header", "content": "─── Beneficios ──────────────────" },
    { "type": "text", "id": "benefits_label", "label": "Label sección", "default": "Lo que Obtienes" },

    { "type": "header", "content": "─── Contenido del Ebook ─────────" },
    { "type": "text", "id": "contents_label", "label": "Label sección", "default": "Dentro del Ebook" },

    { "type": "header", "content": "─── CTA Intermedio ──────────────" },
    { "type": "textarea", "id": "mid_cta_text", "label": "Texto",  "default": "¿Listo para construir la versión más imparable de ti mismo?" },
    { "type": "text",     "id": "mid_cta_btn",  "label": "Botón",  "default": "Sí, Quiero el Ebook →" },

    { "type": "header", "content": "─── Testimonios ─────────────────" },
    { "type": "text", "id": "testimonials_label", "label": "Label sección", "default": "Resultados Reales" },

    { "type": "header", "content": "─── Precio / Oferta ─────────────" },
    { "type": "text", "id": "offer_label",    "label": "Label sección",          "default": "Precio de Lanzamiento" },
    { "type": "text", "id": "offer_subtitle", "label": "Subtítulo del producto", "default": "Ebook Digital · Acceso Inmediato" },
    { "type": "text", "id": "price_was",      "label": "Precio tachado",         "default": "Precio regular: $39.99 USD" },
    { "type": "text", "id": "price_now",      "label": "Precio actual (número)", "default": "9.99" },
    { "type": "text", "id": "price_context",  "label": "Contexto precio",        "default": "USD — Menos de lo que cuesta un café" },
    { "type": "text", "id": "urgency_text",   "label": "Texto de urgencia",      "default": "Precio de lanzamiento · Tiempo limitado" },
    { "type": "text", "id": "offer_cta",      "label": "CTA de compra",          "default": "Obtener Disciplina Imparable →" },
    { "type": "text", "id": "sticky_cta",     "label": "CTA sticky/mobile",      "default": "Obtener →" },

    { "type": "header", "content": "─── Garantía ────────────────────" },
    { "type": "text",     "id": "guarantee_title", "label": "Título",         "default": "7 días sin preguntas" },
    { "type": "textarea", "id": "guarantee_text",  "label": "Texto completo", "default": "Si en los primeros 7 días sientes que Disciplina Imparable no fue lo que esperabas, te devolvemos el 100% de tu dinero. Sin formularios, sin excusas." },
