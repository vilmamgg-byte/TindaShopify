{% comment %}
  Disciplina Imparable — Landing Page
  Sistema de diseño: 8-point grid · Nothing.tech · Linear.app · Apple
  Colores: 5 superficies (#000→#1A1A1A) + gold #B8972A (uso restringido)
  Tipografía: Inter (sans) + Cormorant Garamond (serif) — mezcla de fuentes
{% endcomment %}

{{ 'https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;0,700;1,300;1,400;1,600;1,700&family=Inter:wght@300;400;500;600;700;800;900&display=swap' | stylesheet_tag }}

<style>
/* ════════════════════════════════════════════
   DESIGN TOKENS — Sistema de 8 puntos
   Referencia: Nothing.tech, Linear.app, Apple
════════════════════════════════════════════ */
:root {
  --sp-1:  8px;  --sp-2:  16px; --sp-3:  24px;
  --sp-4:  32px; --sp-5:  40px; --sp-6:  48px;
  --sp-8:  64px; --sp-10: 80px; --sp-12: 96px;
  --sp-15: 120px;--sp-20: 160px;

  --s0: #000000; --s1: #080808; --s2: #0F0F0F;
  --s3: #141414; --s4: #1A1A1A;

  --b1: rgba(255,255,255,0.05);
  --b2: rgba(255,255,255,0.09);
  --b3: rgba(255,255,255,0.16);
  --b-gold: rgba(184,151,42,0.25);

  --t-primary:   #EFEFEF;
  --t-secondary: rgba(239,239,239,0.50);
  --t-tertiary:  rgba(239,239,239,0.28);

  --gold:     #B8972A;
  --gold-dim: rgba(184,151,42,0.08);

  --serif: 'Cormorant Garamond', Georgia, serif;
  --sans:  'Inter', system-ui, sans-serif;

  --max-w:      1200px;
  --max-w-text: 680px;
  --gutter:     clamp(24px, 5vw, 80px);
  --ease:       cubic-bezier(0.25, 0, 0, 1);
}

.di *, .di *::before, .di *::after { box-sizing: border-box; margin: 0; padding: 0; }

.di {
  font-family: var(--sans);
  background: var(--s0);
  color: var(--t-primary);
  -webkit-font-smoothing: antialiased;
  overflow-x: clip;
}

/* ── Contenedor universal ── */
.di .wrap {
  width: 100%;
  max-width: var(--max-w);
  margin-inline: auto;
  padding-inline: var(--gutter);
}

/* ── Label de sección ── */
.di .section-label {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--t-tertiary);
  margin-bottom: var(--sp-6);
}
.di .section-label .num { color: var(--gold); font-variant-numeric: tabular-nums; }
.di .section-label::after {
  content: '';
  flex: 1;
  height: 1px;
  background: var(--b1);
  max-width: 80px;
}

/* ── Botón ── */
.di .btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--sp-2);
  height: 56px;
  padding: 0 var(--sp-6);
  font-family: var(--sans);
  font-size: 14px;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  text-decoration: none;
  border: none;
  cursor: pointer;
  transition: all 0.28s var(--ease);
  white-space: nowrap;
  border-radius: 0;
}

/* ── Botón primario — 3D + resplandor dorado ── */
.di .btn--primary {
  position: relative;
  overflow: hidden;
  background: linear-gradient(180deg, #D4AF47 0%, #B8921E 100%);
  color: #0A0A0A;
  border: none;
  border-radius: 3px;
  /* borde inferior = profundidad física 3D */
  box-shadow:
    0 5px 0 #7A5E0E,
    0 6px 2px rgba(0,0,0,0.5),
    0 0 18px rgba(185,151,42,0.45),
    0 0 40px rgba(185,151,42,0.20),
    inset 0 1px 0 rgba(255,255,255,0.30);
  transition: transform 0.1s ease, box-shadow 0.1s ease;
}
/* brillo superior (cara del botón) */
.di .btn--primary::before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(
    180deg,
    rgba(255,255,255,0.18) 0%,
    rgba(255,255,255,0.00) 55%
  );
  pointer-events: none;
}
/* shimmer animado */
.di .btn--primary::after {
  content: '';
  position: absolute;
  top: 0;
  left: -120%;
  width: 50%;
  height: 100%;
  background: linear-gradient(
    90deg,
    transparent 0%,
    rgba(255,255,255,0.32) 50%,
    transparent 100%
  );
  animation: di-btn-shimmer 3.5s ease infinite;
  pointer-events: none;
}
@keyframes di-btn-shimmer {
  0%        { left: -120%; }
  60%, 100% { left: 170%; }
}
.di .btn--primary:hover {
  transform: translateY(-1px);
  box-shadow:
    0 6px 0 #7A5E0E,
    0 8px 4px rgba(0,0,0,0.5),
    0 0 28px rgba(185,151,42,0.70),
    0 0 60px rgba(185,151,42,0.35),
    0 0 90px rgba(185,151,42,0.15),
    inset 0 1px 0 rgba(255,255,255,0.30);
}
/* al presionar: baja y la sombra se achica = se "hunde" */
.di .btn--primary:active {
  transform: translateY(4px);
  box-shadow:
    0 1px 0 #7A5E0E,
    0 2px 2px rgba(0,0,0,0.4),
    0 0 14px rgba(185,151,42,0.45),
    inset 0 1px 0 rgba(255,255,255,0.20);
}

.di .btn--outline { background: transparent; color: var(--t-secondary); border: 1px solid var(--b2); }
.di .btn--outline:hover { border-color: var(--b3); color: var(--t-primary); }

/* ── Reveal on scroll ── */
.di .reveal {
  opacity: 0;
  transform: translateY(24px);
  transition: opacity 0.7s var(--ease), transform 0.7s var(--ease);
}
.di .reveal.visible { opacity: 1; transform: none; }
.di .reveal-d1 { transition-delay: 0.05s; }
.di .reveal-d2 { transition-delay: 0.10s; }
.di .reveal-d3 { transition-delay: 0.15s; }
.di .reveal-d4 { transition-delay: 0.20s; }
.di .reveal-d5 { transition-delay: 0.25s; }
.di .reveal-d6 { transition-delay: 0.30s; }

/* ════════════════════════════════════════════
   HERO
   min-height: 100svh
   Ruido de grano 4% — textura industrial
   Halo de luz: radial-gradient 6% opacidad
   Tipografía: 2 líneas, 2 fuentes
════════════════════════════════════════════ */
.di .hero {
  position: relative;
  min-height: 100svh;
  display: grid;
  place-items: center;
  text-align: center;
  padding: clamp(var(--sp-15), 15vh, var(--sp-20)) var(--gutter) var(--sp-20);
  background: var(--s0);
  overflow: hidden;
  isolation: isolate;
}
.di .hero::before {
  content: '';
  position: absolute;
  inset: 0;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
  opacity: 0.04;
  z-index: 0;
  pointer-events: none;
}
.di .hero::after {
  content: '';
  position: absolute;
  top: 0; left: 50%;
  transform: translateX(-50%);
  width: min(800px, 100%);
  height: 60%;
  background: radial-gradient(ellipse at top, rgba(184,151,42,0.06) 0%, transparent 65%);
  z-index: 0;
  pointer-events: none;
}
.di .hero__inner {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.di .hero__eyebrow {
  display: inline-flex;
  align-items: center;
  gap: var(--sp-2);
  font-size: 10px;
  font-weight: 500;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--t-tertiary);
  margin-bottom: var(--sp-8);
  opacity: 0;
  animation: di-fade-up 0.9s var(--ease) forwards 0.1s;
}
.di .hero__eyebrow::before,
.di .hero__eyebrow::after {
  content: '';
  width: 4px; height: 4px;
  border-radius: 50%;
  background: var(--gold);
  opacity: 0.6;
}
.di .hero__display {
  margin-bottom: var(--sp-4);
  opacity: 0;
  animation: di-fade-up 0.9s var(--ease) forwards 0.25s;
}
.di .hero__word-sans {
  display: block;
  font-family: var(--sans);
  font-size: clamp(56px, 11vw, 120px);
  font-weight: 800;
  line-height: 0.90;
  letter-spacing: -0.04em;
  text-transform: uppercase;
  color: var(--t-primary);
}
.di .hero__word-serif {
  display: block;
  font-family: var(--serif);
  font-size: clamp(68px, 13vw, 148px);
  font-weight: 300;
  line-height: 0.85;
  letter-spacing: -0.01em;
  font-style: italic;
  color: var(--gold);
}
.di .hero__rule {
  width: 48px; height: 1px;
  background: var(--gold);
  margin: var(--sp-5) auto;
  opacity: 0;
  animation: di-fade-in 0.6s var(--ease) forwards 0.5s;
}
.di .hero__subtitle {
  font-family: var(--serif);
  font-size: clamp(17px, 2.2vw, 20px);
  font-weight: 300;
  font-style: italic;
  line-height: 1.7;
  color: var(--t-secondary);
  max-width: 560px;
  margin-bottom: var(--sp-8);
  opacity: 0;
  animation: di-fade-up 0.9s var(--ease) forwards 0.6s;
}
.di .hero__cta {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--sp-3);
  opacity: 0;
  animation: di-fade-up 0.9s var(--ease) forwards 0.75s;
}
.di .hero__proof {
  font-size: 11px;
  font-weight: 400;
  letter-spacing: 0.06em;
  color: var(--t-tertiary);
}
.di .hero__proof strong { color: var(--t-secondary); font-weight: 500; }
.di .scroll-indicator {
  position: absolute;
  bottom: var(--sp-5);
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--sp-2);
  opacity: 0;
  animation: di-fade-in 1s var(--ease) forwards 1.2s;
}
.di .scroll-indicator span {
  font-size: 9px;
  font-weight: 500;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--t-tertiary);
}
.di .scroll-track {
  width: 1px; height: 48px;
  background: var(--b2);
  position: relative;
  overflow: hidden;
}
.di .scroll-track::after {
  content: '';
  position: absolute;
  top: -100%; left: 0;
  width: 100%; height: 100%;
  background: var(--gold);
  animation: di-scroll-line 2s var(--ease) infinite 1.5s;
}

/* ════════════════════════════════════════════
   MÉTRICAS — Referencia: Apple specs page
   Sin fondo propio. Solo bordes superior/inferior.
   3 números separados por 1px vertical.
════════════════════════════════════════════ */
.di .metrics {
  border-top: 1px solid var(--b1);
  border-bottom: 1px solid var(--b1);
  background: var(--s1);
}
.di .metrics__inner {
  display: flex;
  align-items: stretch;
}
.di .metric {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6px;
  padding: clamp(var(--sp-5), 5vw, var(--sp-8)) var(--sp-3);
  border-right: 1px solid var(--b1);
}
.di .metric:last-child { border-right: none; }
.di .metric__num {
  font-family: var(--serif);
  font-size: clamp(28px, 5vw, 44px);
  font-weight: 600;
  line-height: 1;
  color: var(--t-primary);
  letter-spacing: -0.02em;
}
.di .metric__label {
  font-size: 10px;
  font-weight: 500;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--t-tertiary);
}

/* ════════════════════════════════════════════
   SECCIONES — Padding fluido, superficies alternas
════════════════════════════════════════════ */
.di .section {
  padding-block: clamp(var(--sp-10), 10vw, var(--sp-15));
}
.di .section--s0 { background: var(--s0); }
.di .section--s1 { background: var(--s1); }
.di .section--s2 { background: var(--s2); }

/* ════════════════════════════════════════════
   01 — DOLOR
   2 columnas desktop: 5fr / 7fr
   Lista con separadores 1px, sin bullets
════════════════════════════════════════════ */
.di .pain__grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: clamp(var(--sp-8), 6vw, var(--sp-15));
  align-items: start;
}
@media (min-width: 800px) {
  .di .pain__grid { grid-template-columns: 5fr 7fr; }
}
.di .pain__headline {
  font-family: var(--serif);
  font-size: clamp(36px, 5vw, 56px);
  font-weight: 300;
  font-style: italic;
  line-height: 1.15;
  letter-spacing: -0.01em;
  color: var(--t-primary);
  margin-top: var(--sp-1);
}
.di .pain__list {
  list-style: none;
  border-top: 1px solid var(--b1);
}
.di .pain__item {
  display: grid;
  grid-template-columns: 20px 1fr;
  gap: var(--sp-3);
  padding: var(--sp-4) 0;
  border-bottom: 1px solid var(--b1);
  font-size: 15px;
  line-height: 1.6;
  color: var(--t-secondary);
  transition: color 0.2s var(--ease);
}
.di .pain__item:hover { color: var(--t-primary); }
.di .pain__item::before {
  content: '—';
  color: var(--gold);
  font-size: 14px;
  font-weight: 700;
  line-height: 1.6;
}
.di .pain__bridge {
  margin-top: var(--sp-8);
  padding-top: var(--sp-8);
  border-top: 1px solid var(--b1);
  display: flex;
  align-items: flex-start;
  gap: var(--sp-3);
}
.di .pain__bridge-rule {
  width: 32px;
  height: 1px;
  background: var(--gold);
  margin-top: 16px;
  flex-shrink: 0;
}
.di .pain__bridge-text {
  flex: 1;
  min-width: 0;
  font-family: var(--serif);
  font-size: clamp(20px, 3vw, 30px);
  font-weight: 400;
  font-style: italic;
  line-height: 1.4;
  color: var(--t-primary);
}

/* ════════════════════════════════════════════
   02 — SOLUCIÓN
   Nombre del libro: 2 líneas, 2 fuentes
   Promesa: borde izquierdo 2px gold
════════════════════════════════════════════ */
.di .promise__center {
  max-width: 640px;
  margin-inline: auto;
  text-align: center;
}
.di .promise__title {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0;
  margin-bottom: var(--sp-8);
}
.di .promise__title .word-a {
  font-family: var(--sans);
  font-size: clamp(40px, 7vw, 80px);
  font-weight: 800;
  line-height: 0.9;
  letter-spacing: -0.04em;
  text-transform: uppercase;
  color: var(--t-primary);
}
.di .promise__title .word-b {
  font-family: var(--serif);
  font-size: clamp(52px, 9vw, 104px);
  font-weight: 300;
  line-height: 0.85;
  letter-spacing: -0.01em;
  font-style: italic;
  color: var(--gold);
}
.di .promise__body {
  font-size: 17px;
  line-height: 1.7;
  color: var(--t-secondary);
  margin-bottom: var(--sp-8);
}
.di .promise__quote {
  border-left: 2px solid var(--gold);
  padding: var(--sp-4) var(--sp-5);
  text-align: left;
  font-family: var(--serif);
  font-size: clamp(18px, 2.5vw, 24px);
  font-weight: 400;
  font-style: italic;
  line-height: 1.6;
  color: var(--t-primary);
  background: var(--gold-dim);
}

/* ════════════════════════════════════════════
   03 — BENEFICIOS
   Grid de bordes, sin cards flotantes
   Sin emojis. Numeración tabular en gold.
   Referencia: Linear.app features
════════════════════════════════════════════ */
.di .benefits__grid {
  display: grid;
  grid-template-columns: 1fr;
  border-top: 1px solid var(--b1);
}
@media (min-width: 640px) {
  .di .benefits__grid { grid-template-columns: 1fr 1fr; }
}
@media (min-width: 960px) {
  .di .benefits__grid { grid-template-columns: 1fr 1fr 1fr; }
}
.di .benefit {
  padding: var(--sp-6) var(--sp-5);
  border-bottom: 1px solid var(--b1);
  border-right: 1px solid var(--b1);
  display: flex;
  flex-direction: column;
  gap: var(--sp-2);
  transition: background 0.2s var(--ease);
}
.di .benefit:hover { background: var(--s3); }
.di .benefit__num {
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.1em;
  color: var(--gold);
  font-variant-numeric: tabular-nums;
  margin-bottom: var(--sp-1);
}
.di .benefit__title {
  font-size: 17px;
  font-weight: 600;
  line-height: 1.3;
  color: var(--t-primary);
  letter-spacing: -0.01em;
}
.di .benefit__text {
  font-size: 14px;
  line-height: 1.65;
  color: var(--t-secondary);
}

/* ════════════════════════════════════════════
   04 — CONTENIDO DEL EBOOK
   Tabla de capítulos: número + título + desc
   Referencia: Apple specs table
════════════════════════════════════════════ */
.di .chapters { max-width: var(--max-w-text); margin-inline: auto; }
.di .chapter {
  display: grid;
  grid-template-columns: 40px 1fr;
  gap: var(--sp-4);
  padding-block: var(--sp-5);
  border-bottom: 1px solid var(--b1);
  align-items: start;
}
.di .chapter:first-child { border-top: 1px solid var(--b1); }
.di .chapter__num {
  font-family: var(--serif);
  font-size: 13px;
  font-weight: 600;
  color: var(--gold);
  letter-spacing: 0.06em;
  padding-top: 3px;
  font-variant-numeric: tabular-nums;
}
.di .chapter__title {
  font-size: 16px;
  font-weight: 600;
  color: var(--t-primary);
  margin-bottom: 6px;
  letter-spacing: -0.01em;
}
.di .chapter__desc {
  font-size: 14px;
  line-height: 1.6;
  color: var(--t-secondary);
}

/* ════════════════════════════════════════════
   CTA INTERMEDIO
   Solo texto serif italic + botón
   Referencia: Nothing.tech CTA break
════════════════════════════════════════════ */
.di .mid-cta {
  padding-block: clamp(var(--sp-10), 10vw, var(--sp-15));
  background: var(--s0);
  border-top: 1px solid var(--b1);
  border-bottom: 1px solid var(--b1);
  text-align: center;
}
.di .mid-cta__text {
  font-family: var(--serif);
  font-size: clamp(24px, 4vw, 44px);
  font-weight: 300;
  font-style: italic;
  line-height: 1.25;
  color: var(--t-primary);
  max-width: 640px;
  margin-inline: auto;
  margin-bottom: var(--sp-8);
  letter-spacing: -0.01em;
}

/* ════════════════════════════════════════════
   05 — TESTIMONIOS
   3 columnas con 1px separadores verticales
   Comilla 160px en bg, 4% opacidad
   Sin card borders en todos los lados
════════════════════════════════════════════ */
.di .testimonials__grid {
  display: grid;
  grid-template-columns: 1fr;
  border-top: 1px solid var(--b1);
}
@media (min-width: 760px) {
  .di .testimonials__grid { grid-template-columns: repeat(3, 1fr); }
}
.di .testimonial {
  position: relative;
  padding: var(--sp-8) var(--sp-6);
  border-bottom: 1px solid var(--b1);
  border-right: 1px solid var(--b1);
  overflow: hidden;
}
@media (min-width: 760px) {
  .di .testimonials__grid .testimonial:last-child { border-right: none; }
}
.di .testimonial::before {
  content: '\201C';
  font-family: var(--serif);
  font-size: 160px;
  line-height: 1;
  color: var(--t-primary);
  opacity: 0.04;
  position: absolute;
  top: var(--sp-3);
  left: var(--sp-4);
  pointer-events: none;
  user-select: none;
}
.di .testimonial__text {
  font-family: var(--serif);
  font-size: clamp(16px, 2vw, 19px);
  font-weight: 400;
  font-style: italic;
  line-height: 1.65;
  color: var(--t-secondary);
  margin-bottom: var(--sp-6);
  position: relative;
}
.di .testimonial__author {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
}
.di .testimonial__avatar {
  width: 32px; height: 32px;
  background: var(--gold-dim);
  border: 1px solid var(--b-gold);
  display: grid;
  place-items: center;
  font-family: var(--serif);
  font-size: 15px;
  font-weight: 700;
  color: var(--gold);
  flex-shrink: 0;
}
.di .testimonial__name {
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--t-primary);
  line-height: 1.3;
}
.di .testimonial__role {
  font-size: 11px;
  color: var(--t-tertiary);
  margin-top: 2px;
  letter-spacing: 0.04em;
}
.di .testimonial__stars {
  margin-top: var(--sp-4);
  display: flex;
  gap: 3px;
}
.di .testimonial__stars span {
  width: 6px; height: 6px;
  background: var(--gold);
  clip-path: polygon(50% 0%,61% 35%,98% 35%,68% 57%,79% 91%,50% 70%,21% 91%,32% 57%,2% 35%,39% 35%);
}

/* ════════════════════════════════════════════
   06 — PRECIO
   El número del precio: protagonista único.
   Cormorant 96-112px — sin competencia visual.
   Referencia: Apple pricing page
════════════════════════════════════════════ */
.di .offer {
  padding-block: clamp(var(--sp-10), 10vw, var(--sp-20));
  background: var(--s1);
  text-align: center;
  border-top: 1px solid var(--b1);
  border-bottom: 1px solid var(--b1);
}
.di .offer__inner { max-width: 560px; margin-inline: auto; }
.di .offer__product {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--sp-1);
  margin-bottom: var(--sp-10);
}
.di .offer__name {
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--t-tertiary);
}
.di .offer__title-serif {
  font-family: var(--serif);
  font-size: clamp(28px, 5vw, 44px);
  font-weight: 300;
  font-style: italic;
  color: var(--t-primary);
  line-height: 1.1;
  letter-spacing: -0.01em;
}
.di .offer__includes {
  list-style: none;
  margin-bottom: var(--sp-10);
  border-top: 1px solid var(--b1);
}
.di .offer__includes li {
  display: grid;
  grid-template-columns: 16px 1fr;
  gap: var(--sp-2);
  padding: var(--sp-2) 0;
  border-bottom: 1px solid var(--b1);
  font-size: 14px;
  color: var(--t-secondary);
  text-align: left;
}
.di .offer__includes li::before {
  content: '✓';
  font-size: 11px;
  font-weight: 700;
  color: var(--gold);
  padding-top: 2px;
}
.di .price-block {
  margin-bottom: var(--sp-8);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--sp-1);
}
.di .price-was {
  font-size: 13px;
  color: var(--t-tertiary);
  text-decoration: line-through;
  letter-spacing: 0.04em;
}
.di .price-now {
  font-family: var(--serif);
  font-size: clamp(72px, 14vw, 112px);
  font-weight: 600;
  line-height: 0.9;
  color: var(--t-primary);
  letter-spacing: -0.03em;
  display: flex;
  align-items: flex-start;
  gap: 4px;
}
.di .price-now sup {
  font-size: 0.3em;
  vertical-align: super;
  font-weight: 400;
  color: var(--t-secondary);
  margin-top: 12px;
}
.di .price-context {
  font-size: 12px;
  color: var(--t-tertiary);
  letter-spacing: 0.06em;
}
.di .urgency {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--sp-2);
  margin-bottom: var(--sp-6);
  font-size: 12px;
  font-weight: 500;
  letter-spacing: 0.08em;
  color: var(--gold);
}
.di .urgency::before {
  content: '';
  width: 6px; height: 6px;
  background: var(--gold);
  border-radius: 50%;
  animation: di-pulse 2s ease infinite;
}
.di .offer__btn { width: 100%; max-width: 360px; display: block; margin: 0 auto; text-align: center; }
.di .offer__guarantee {
  margin-top: var(--sp-4);
  font-size: 11px;
  letter-spacing: 0.06em;
  color: var(--t-tertiary);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--sp-2);
}
.di .offer__guarantee::before { content: '—'; color: var(--b3); }

/* ════════════════════════════════════════════
   07 — GARANTÍA
════════════════════════════════════════════ */
.di .guarantee { max-width: 560px; margin-inline: auto; text-align: center; }
.di .guarantee__title {
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--t-secondary);
  margin-bottom: var(--sp-3);
}
.di .guarantee__text {
  font-size: 15px;
  line-height: 1.7;
  color: var(--t-tertiary);
}

/* ════════════════════════════════════════════
   08 — FAQ
   Referencia: Linear.app FAQ
   El + rota 45° en lugar de cambiar a ×
════════════════════════════════════════════ */
.di .faq { max-width: var(--max-w-text); margin-inline: auto; }
.di .faq__item { border-bottom: 1px solid var(--b1); }
.di .faq__item:first-child { border-top: 1px solid var(--b1); }
.di .faq__trigger {
  width: 100%;
  background: none;
  border: none;
  padding: var(--sp-5) 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--sp-4);
  cursor: pointer;
  text-align: left;
  transition: opacity 0.2s var(--ease);
}
.di .faq__trigger:hover { opacity: 0.8; }
.di .faq__q {
  font-size: 16px;
  font-weight: 500;
  color: var(--t-primary);
  line-height: 1.4;
  letter-spacing: -0.01em;
}
.di .faq__icon {
  width: 20px; height: 20px;
  flex-shrink: 0;
  position: relative;
  color: var(--gold);
  transition: transform 0.3s var(--ease);
}
.di .faq__icon::before,
.di .faq__icon::after {
  content: '';
  position: absolute;
  background: currentColor;
}
.di .faq__icon::before { width: 1px; height: 100%; left: 50%; transform: translateX(-50%); }
.di .faq__icon::after  { width: 100%; height: 1px; top: 50%; transform: translateY(-50%); }
.di .faq__item.open .faq__icon { transform: rotate(45deg); }
.di .faq__body {
  display: none;
  padding-bottom: var(--sp-5);
  font-size: 14px;
  line-height: 1.75;
  color: var(--t-secondary);
  max-width: 560px;
}
.di .faq__item.open .faq__body { display: block; }

/* ════════════════════════════════════════════
   09 — CTA FINAL
   Referencia: Apple "Get it today"
   Solo tipografía grande + botón. Sin fondo especial.
════════════════════════════════════════════ */
.di .final-cta {
  padding-block: clamp(var(--sp-15), 15vw, var(--sp-20));
  background: var(--s0);
  text-align: center;
  border-top: 1px solid var(--b1);
}
.di .final-cta__inner {
  max-width: 640px;
  margin-inline: auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--sp-6);
}
.di .final-cta__title {
  font-family: var(--serif);
  font-size: clamp(40px, 7vw, 72px);
  font-weight: 300;
  font-style: italic;
  line-height: 1.1;
  letter-spacing: -0.02em;
  color: var(--t-primary);
}
.di .final-cta__title span { color: var(--gold); }
.di .final-cta__sub {
  font-size: 15px;
  line-height: 1.7;
  color: var(--t-secondary);
  max-width: 440px;
}
.di .final-cta__note {
  font-size: 11px;
  letter-spacing: 0.08em;
  color: var(--t-tertiary);
}

/* ════════════════════════════════════════════
   STICKY BAR MOBILE — altura 64px exacta
   backdrop-filter: blur(20px)
════════════════════════════════════════════ */
.di .sticky-bar {
  display: none;
  position: fixed;
  bottom: 0; left: 0; right: 0;
  height: 64px;
  background: rgba(8,8,8,0.92);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-top: 1px solid var(--b2);
  z-index: 500;
  padding: 0 var(--sp-3);
  align-items: center;
  justify-content: space-between;
  gap: var(--sp-2);
}
@media (max-width: 640px) { .di .sticky-bar { display: flex; } }
.di .sticky-bar__info { display: flex; flex-direction: column; gap: 2px; }
.di .sticky-bar__name { font-size: 13px; font-weight: 600; color: var(--t-primary); letter-spacing: -0.01em; }
.di .sticky-bar__price { font-size: 11px; color: var(--t-tertiary); }
.di .sticky-bar .btn { height: 40px; padding: 0 var(--sp-4); font-size: 13px; }

@media (max-width: 640px) { .di { padding-bottom: 64px; } }

/* ── Keyframes ── */
@keyframes di-fade-up {
  from { opacity: 0; transform: translateY(20px); }
  to   { opacity: 1; transform: translateY(0); }
}
@keyframes di-fade-in {
  from { opacity: 0; } to { opacity: 1; }
}
@keyframes di-scroll-line {
  0% { top: -100%; } 100% { top: 100%; }
}
@keyframes di-pulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50%       { opacity: 0.4; transform: scale(0.7); }
}
</style>

<div class="di" id="disciplina-imparable">

  {%- comment -%} ── HERO ── {%- endcomment -%}
  <section class="di hero">
    <div class="di hero__inner">
      <span class="di hero__eyebrow">{{ section.settings.hero_eyebrow }}</span>

      <div class="di hero__display">
        <span class="di hero__word-sans">{{ section.settings.hero_word_sans }}</span>
        <span class="di hero__word-serif">{{ section.settings.hero_word_serif }}</span>
      </div>

      <div class="di hero__rule"></div>

      <p class="di hero__subtitle">{{ section.settings.hero_subtitle }}</p>

      <div class="di hero__cta">
        {%- if section.settings.product_url != blank -%}
          <a href="{{ section.settings.product_url }}" class="di btn btn--primary">
            {{ section.settings.hero_cta }}
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        {%- endif -%}
        <span class="di hero__proof">
          <strong>{{ section.settings.proof_number }}</strong> {{ section.settings.proof_text }}
        </span>
      </div>
    </div>

    <div class="di scroll-indicator">
      <span>Scroll</span>
      <div class="di scroll-track"></div>
    </div>
  </section>

  {%- comment -%} ── MÉTRICAS ── {%- endcomment -%}
  <div class="di metrics">
    <div class="di metrics__inner wrap">
      <div class="di metric">
        <span class="di metric__num">{{ section.settings.stat_1_num }}</span>
        <span class="di metric__label">{{ section.settings.stat_1_label }}</span>
      </div>
      <div class="di metric">
        <span class="di metric__num">{{ section.settings.stat_2_num }}</span>
        <span class="di metric__label">{{ section.settings.stat_2_label }}</span>
      </div>
      <div class="di metric">
        <span class="di metric__num">{{ section.settings.stat_3_num }}</span>
        <span class="di metric__label">{{ section.settings.stat_3_label }}</span>
      </div>
    </div>
  </div>

  {%- comment -%} ── 01 DOLOR ── {%- endcomment -%}
  <section class="di section section--s2">
    <div class="di wrap">
      <div class="di pain__grid">
        <div>
          <div class="di section-label reveal">
            <span class="di num">01</span>
            {{ section.settings.pain_label }}
          </div>
          <h2 class="di pain__headline reveal">{{ section.settings.pain_headline }}</h2>
        </div>
        <div>
          <ul class="di pain__list">
            {%- for block in section.blocks -%}
              {%- if block.type == 'pain_point' -%}
                <li class="di pain__item reveal reveal-d{{ forloop.index }}" {{ block.shopify_attributes }}>
                  {{ block.settings.text }}
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
          <div class="di pain__bridge reveal">
            <div class="di pain__bridge-rule"></div>
            <p class="di pain__bridge-text">{{ section.settings.pain_bridge }}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  {%- comment -%} ── 02 SOLUCIÓN ── {%- endcomment -%}
  <section class="di section section--s0">
    <div class="di wrap">
      <div class="di section-label reveal" style="justify-content:center">
        <span class="di num">02</span>
        {{ section.settings.solution_label }}
      </div>
      <div class="di promise__center">
        <div class="di promise__title reveal">
          <span class="di word-a">{{ section.settings.hero_word_sans }}</span>
          <span class="di word-b">{{ section.settings.hero_word_serif }}</span>
        </div>
        <p class="di promise__body reveal">{{ section.settings.solution_body }}</p>
