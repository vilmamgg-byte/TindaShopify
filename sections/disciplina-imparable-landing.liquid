      </div>
    </div>
  </section>

  {%- comment -%} ── 03 BENEFICIOS ── {%- endcomment -%}
  <section class="di section section--s1">
    <div class="di wrap">
      <div class="di section-label reveal">
        <span class="di num">03</span>
        {{ section.settings.benefits_label }}
      </div>
      <div class="di benefits__grid">
        {%- assign benefit_index = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'benefit' -%}
            {%- assign benefit_index = benefit_index | plus: 1 -%}
            {%- assign delay_class = 'reveal-d' | append: benefit_index -%}
            <div class="di benefit reveal {{ delay_class }}" {{ block.shopify_attributes }}>
              <span class="di benefit__num">{{ benefit_index | prepend: '0' | slice: -2, 2 }}</span>
              <h3 class="di benefit__title">{{ block.settings.title }}</h3>
              <p class="di benefit__text">{{ block.settings.text }}</p>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>

  {%- comment -%} ── 04 CONTENIDO ── {%- endcomment -%}
  <section class="di section section--s2">
    <div class="di wrap">
      <div class="di section-label reveal">
        <span class="di num">04</span>
        {{ section.settings.contents_label }}
      </div>
